# What runsc (gVisor) itself needs from the guest kernel.
# systrap platform: seccomp filters with SECCOMP_RET_TRAP
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# sandbox + gofer isolation
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
# runs with --ignore-cgroups, but runsc probes for cgroupfs
CONFIG_CGROUPS=y
# gVisor has no MEMBARRIER_CMD_PRIVATE_EXPEDITED_SYNC_CORE in its kernel. It
# answers the SYNC_CORE request with EINVAL and relies on the guest kernel
# supporting MEMBARRIER_CMD_GLOBAL instead (pkg/sentry/hostmm). Without this,
# every membarrier(2) from a sandbox fails and aarch64 JIT workloads break:
# Wasmtime's icache-coherence flush aborts with "Failed pipeline flush:
# Invalid argument", so WASI 0.3 components cannot instantiate under runsc.
CONFIG_MEMBARRIER=y
# Guest CNI networking for oci-lib (crates/oci-cri): veth pairs, bridge, tc
# cgroup classification, bridge netfilter, and iptables MASQUERADE NAT so CNI
# sandboxes get isolated network namespaces instead of sharing the guest netns.
# From tinyconfig, NET_CLS has no prompt of its own (selected by NET_CLS_CGROUP)
# and BRIDGE_NETFILTER / IP_NF_TARGET_MASQUERADE require the netfilter +
# conntrack + legacy xtables/iptables NAT chain enabled below.
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NET_SCHED=y
CONFIG_NET_CLS=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
